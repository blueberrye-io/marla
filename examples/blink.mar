# Referenzprogramm Phase 1 (Sprachreferenz Rev. 2, Abschnitt 12)
extern fn hal_led_write(on: bool)
extern fn hal_delay_ms(ms: u16)

const BLINK_MS: u16 := 500

fn main():
    let mut counter: u16 := 0
    loop:
        hal_led_write(true)
        hal_delay_ms(BLINK_MS)
        hal_led_write(false)
        hal_delay_ms(BLINK_MS)
        counter := counter + 1
        if counter = 100:
            counter := 0
        if counter mod 10 <> 0:
            hal_delay_ms(100)
